# Env split (single source of truth — see AGENTS.md / alchemy.run.ts & alchemy.deploy.ts):
#
#   .env.common — shared secrets, used by BOTH dev and prod. Edit this ALONE when a secret changes.
#   .env        — DEV domain values only (BETTER_AUTH_URL / CORS_ORIGIN = localhost).
#   .env.prod   — PROD domain values only (BETTER_AUTH_URL / CORS_ORIGIN = your domain).
# This file docs the dev `.env`; copy it to `.env` and fill `.env.common` (below).

# --- Required: Auth (domain values from .env.common may include the secret) ---
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# --- Everything below lives in `.env.common` (share between dev & prod) ---

# --- Required: Auth ---
BETTER_AUTH_SECRET=

# --- Required: GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional: single-owner signup lock ---
# Pre-lock signups to this GitHub username (leave empty for first-signup-wins)
GITHUB_USERNAME=your-github-username
# Hard-disable new signups (set "true" after your account exists)
DISABLE_SIGNUP=false

# --- D1 tooling (drizzle-kit migrations) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# --- Source Postgres (used by `db:migrate`) ---
DATABASE_URL=

# --- Optional: Cloudflare Web Analytics ---
# Leave empty to disable the analytics beacon (e.g. in local dev)
VITE_CLOUDFLARE_ANALYTICS_TOKEN=
