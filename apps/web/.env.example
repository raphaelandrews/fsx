# --- Required: Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# --- Required: GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional: single-owner signup lock ---
# Pre-lock signups to this GitHub username (leave empty for first-signup-wins)
GITHUB_USERNAME=your-github-username
# Hard-disable new signups (set "true" after your account exists)
DISABLE_SIGNUP=false

# --- D1 tooling (drizzle-kit migrations) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
