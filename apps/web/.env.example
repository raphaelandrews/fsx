# Environment configuration
#
# Variables are split across files so secrets live in one place:
#
#   apps/web/.env.common   — shared values/secrets used by BOTH dev and prod.
#   apps/web/.env          — DEV-only values (localhost URLs).
#   apps/web/.env.prod     — PROD-only values (production URLs).
#   packages/infra/.env    — Alchemy state password (see the end of this file).
#
# Dev   (`bun dev`):    .env.common + .env
# Prod  (`bun deploy`): .env.common + .env.prod
#
# Alchemy loads these into process.env (alchemy.run.ts / alchemy.deploy.ts) and
# binds them to the Worker. Do NOT duplicate shared variables in .env or .env.prod.


# ============================================================
# DEV-ONLY — apps/web/.env
# ============================================================

BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001


# ============================================================
# PROD-ONLY — apps/web/.env.prod
# ============================================================
#
# BETTER_AUTH_URL=https://www.fsx.org.br
# CORS_ORIGIN=https://www.fsx.org.br
# DOCS_DOMAIN=docs.fsx.org.br   # docs site custom domain; omit for a workers.dev URL


# ============================================================
# SHARED — apps/web/.env.common
# ============================================================

# --- Auth ---
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Single-owner lock ---
# Numeric GitHub account ID of the owner (https://api.github.com/users/<login> -> "id").
# Only this account can sign in or use the dashboard. Recommended: logins can be
# renamed and reclaimed by someone else, IDs cannot.
GITHUB_USER_ID=
# Legacy fallback used only when GITHUB_USER_ID is empty: GitHub login allowed
# to sign up. Leave both empty for first-signup-wins behavior.
GITHUB_USERNAME=
# Set to "true" to disable new signups after your account exists.
DISABLE_SIGNUP=false

# --- Cloudflare account (deploys, Wrangler backups) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Optional: dashboard "Purge public cache" button ---
# Zone ID of fsx.org.br and a token with Zone → Cache Purge. Without both, the
# dashboard Cache page shows manual purge steps instead.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=

# --- Optional: Cloudflare Web Analytics ---
# Site token from Cloudflare → Analytics & Logs → Web Analytics (manual JS snippet).
# Read at BUILD time by Vite: deploy builds pick it up from .env.common; a plain
# local `bun run build` does not. Leave empty to omit the beacon (e.g. when
# Cloudflare's automatic setup already injects it).
VITE_CLOUDFLARE_ANALYTICS_TOKEN=


# ============================================================
# ALCHEMY — packages/infra/.env
# ============================================================
#
# Encrypts secrets stored in Alchemy state. Keep it stable: changing it makes
# existing encrypted state unreadable.
#
# ALCHEMY_PASSWORD=
