# Environment configuration
#
# This project splits environment variables across three files:
#
#   .env.common — shared values/secrets used by BOTH dev and prod.
#   .env        — DEV-only values (localhost URLs).
#   .env.prod   — PROD-only values (production URLs).
#
# Shared secrets/configuration should only be edited in `.env.common`.
# Do NOT duplicate shared variables in `.env` or `.env.prod`.
#
# Dev:
#   .env.common + .env
#
# Prod:
#   .env.common + .env.prod
#
# See AGENTS.md, alchemy.run.ts, and alchemy.deploy.ts for the
# environment loading/deployment setup.
#
# This file documents the DEV `.env`.
# Copy it to `.env` and fill in `.env.common` separately.


# ============================================================
# DEV-ONLY — .env
# ============================================================

# --- Auth ---
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001


# ============================================================
# SHARED — .env.common
# ============================================================
#
# The following variables are shared between dev and prod.
# Put their actual values in `.env.common`, NOT in `.env`.
#

# --- Auth ---
BETTER_AUTH_SECRET=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional: single-owner signup lock ---
# GitHub username allowed to create the first/only account.
# Leave empty for first-signup-wins behavior.
GITHUB_USERNAME=

# Set to "true" to disable new signups after your account exists.
DISABLE_SIGNUP=false


# --- Cloudflare / D1 tooling ---
#
# Used by tooling such as drizzle-kit migrations.
#
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=


# --- Optional: Cloudflare Web Analytics ---
#
# Leave empty to disable the analytics beacon.
#
VITE_CLOUDFLARE_ANALYTICS_TOKEN=

