{
  "name": "fsx",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^22.20.1",
      "@hugeicons/react": "^1.1.9",
      "@hugeicons/core-free-icons": "^4.2.3",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.17.4",
      "libsql": "0.5.29",
      "@trpc/server": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "better-auth": "1.6.25",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "alchemy": "^0.93.12"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "oxlint && oxfmt --write",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:generate": "vp run --filter @fsx/db db:generate",
    "db:seed": "vp run --filter @fsx/db db:seed",
    "deploy": "vp run --filter @fsx/infra deploy",
    "destroy": "vp run --filter @fsx/infra destroy"
  },
  "dependencies": {
    "@fsx/env": "workspace:*",
    "dotenv": "catalog:",
    "motion": "^12.43.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@fsx/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "rolldown": "1.2.0",
    "typescript": "catalog:",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "packageManager": "bun@1.3.13"
}
