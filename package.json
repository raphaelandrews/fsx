{
  "name": "fsx",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/node": "^22.20.1",
      "@hugeicons/react": "^1.1.9",
      "@hugeicons/core-free-icons": "^4.2.3",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@trpc/server": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "better-auth": "1.7.7",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "alchemy": "0.93.12"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "oxlint && oxfmt --write",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:generate": "vp run --filter @fsx/db db:generate",
    "db:seed": "vp run --filter @fsx/db db:seed",
    "db:seed:remote": "bun packages/db/src/seed.ts --remote",
    "db:seed:latest": "bun packages/db/src/seed.ts --latest",
    "db:backup": "bash scripts/d1-backup.sh",
    "db:backup:verify": "bash scripts/verify-d1-backup.sh",
    "db:restore-drill": "bun apps/web/scripts/restore-drill.ts",
    "db:restore-local": "bun packages/api/scripts/restore-local.ts",
    "check:bundle": "node scripts/check-bundle-budgets.mjs",
    "check:seo": "node scripts/check-prerendered-seo.mjs",
    "check:routes": "node scripts/check-route-tree.mjs",
    "check:runtime": "node scripts/check-runtime-pins.mjs",
    "check:ssr": "bun apps/web/scripts/check-ssr.ts",
    "measure": "bun packages/api/scripts/measure.ts",
    "deploy": "vp run --filter @fsx/infra deploy",
    "test": "bun test",
    "test:e2e": "vp run --filter web test:e2e"
  },
  "dependencies": {
    "@fsx/env": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@fsx/config": "workspace:*",
    "@types/node": "^22.20.5",
    "bun-types": "1.3.13",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.89.0",
    "rolldown": "1.2.0",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "workerd": "1.20260730.1",
    "brace-expansion": "^5.0.11",
    "devalue": "^5.9.3",
    "fast-uri": "^3.1.7",
    "hono": "^4.13.7",
    "ip-address": "^10.7.3",
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8",
    "tinypool": "^2.2.0",
    "http-cache-semantics": "^4.3.0",
    "source-map-js": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "smol-toml": "^1.9.1",
    "postcss-selector-parser": "^7.1.6",
    "seroval": "^1.6.4",
    "seroval-plugins": "^1.6.4",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "body-parser": "^2.4.0",
    "launch-editor": "^2.14.2",
    "@tanstack/start-server-core": "^1.169.45",
    "ws": "^8.21.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "packageManager": "bun@1.3.13"
}
